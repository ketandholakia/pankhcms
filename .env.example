APP_NAME=PankhCMS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/PankhCMS/public

# Comma-separated IPs/CIDRs of reverse proxies that may set
# X-Forwarded-For / X-Real-IP. Leave empty when PHP receives the
# connection directly from the client.
TRUSTED_PROXIES=
# Which ONE forwarding header the trusted proxy provides:
# X-Forwarded-For (default), X-Real-IP, or CF-Connecting-IP.
# Only this single header is trusted for client-IP resolution.
TRUSTED_PROXY_HEADER=X-Forwarded-For

# Comma-separated hostnames whose pages may be written to/served
# from the full-page cache (the host of APP_URL is always included).
# Requests carrying any other Host header bypass the page cache.
ALLOWED_HOSTS=

# Outgoing mail (password resets, contact notifications). Leave
# MAIL_HOST empty to use PHP's built-in mail() (local delivery only).
# MAIL_ENCRYPTION: tls (default), ssl, or none.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=PankhCMS

DB_CONNECTION=sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flight_cms
DB_USERNAME=root
DB_PASSWORD=
