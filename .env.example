APP_NAME=PankhCMS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/PankhCMS/public

# Comma-separated IPs/CIDRs of reverse proxies that may set
# X-Forwarded-For / X-Real-IP. Leave empty when PHP receives the
# connection directly from the client.
TRUSTED_PROXIES=

DB_CONNECTION=sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flight_cms
DB_USERNAME=root
DB_PASSWORD=
