# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error-debug.log*

# =========================
# Environment Files
# =========================
.env
.env.*
!.env.example

# =========================
# Composer
# =========================
vendor/
# composer.lock should NOT be ignored for apps

# =========================
# Node / Frontend
# (anchored: never match source dirs such as views/, app/, themes/, resources/)
# =========================
node_modules/
/dist/
/build/
/public/build/
/public/hot

# =========================
# Cache & Temp
# =========================
*.cache
/tmp/
/temp/
/storage/cache/
/storage/backups/

# =========================
# Laravel-style (if applicable)
# =========================
bootstrap/cache/*
storage/*.key
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
!storage/app/public/

# =========================
# Uploads / User Content
# =========================
/public/uploads/
/public/uploads/media/
/public/uploads/settings/
/public/uploads/slider/
/public/uploads/files/
/files/

# =========================
# Database
# =========================
*.sqlite
*.db

# =========================
# Testing
# =========================
.phpunit.result.cache

# =========================
# Misc
# =========================
*.bak
*.swp
*.tmp
*.old

# =========================
# Devilbox / Docker (optional)
# =========================
docker-data/
.docker/
/public/install/lock
